# ── Source database ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-source-db-password-here
SOURCE_DB_NAME=source_db
SOURCE_DB_PORT=5433

# ── Target database ────────────────────────────────────────────────────────────
TARGET_POSTGRES_USER=postgres
TARGET_POSTGRES_PASSWORD=your-target-db-password-here
TARGET_DB_NAME=target_db
TARGET_DB_PORT=5434

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BROKER=kafka:29092

# ── Kafka Connect / Debezium ───────────────────────────────────────────────────
CONNECT_URL=http://connect:8083
# Credentials the Debezium connector uses to connect to source-db.
# Should match POSTGRES_USER / POSTGRES_PASSWORD above.
CONNECTOR_DB_USER=postgres
CONNECTOR_DB_PASSWORD=your-source-db-password-here

# ── Consumer application ───────────────────────────────────────────────────────
KAFKA_TOPIC=dbserver1.public.products
DB_HOST=target-db
DB_PORT=5432
DB_NAME=target_db
DB_USER=postgres
# Should match TARGET_POSTGRES_PASSWORD above.
DB_PASSWORD=your-target-db-password-here
